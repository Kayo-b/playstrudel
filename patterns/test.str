register('slowLFO', (pat) => pat.lpf(sine.range(400, 1200).slow(1.5)))
register('fastLFO', (pat) => pat.lpf(square.range(400, 2000).fast(1.5)))

// let note1 = ""
let pad = (val, rev = 0.1, revSize = 0) => {
  return note(val) 
.s("gm_pad_warm")
.partials([1, 0.8, 0,7])
.add(note(0.02))
.slowLFO()
.lpq(3)
.lpenv(0.1)
.lpa(0.5)
.lpd(1.5)
.lps(0.3)
.room(rev)
.roomsize(revSize)
.gain(0.5)
.attack(2)
.decay(9)
.release(4)
.sustain(0.2)
} 
let bd =
sound("bd")
.bank("RolandTR808")
.crush(12)
.distort(2)
.room(0.5)

